generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  SUPER_ADMIN
  STORE_ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PICKING
  PACKED
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  REFUNDED
  WAITING_PAYMENT
  WAITING_PAYMENT_CONFIRMATION
  PROCESSING
  SHIPPED
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  NOMINAL
  BOGO
}

enum VoucherScope {
  PRODUCT
  CART
  SHIPPING
}

enum StoreAdminRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id                         String              @id @default(cuid())
  name                       String
  email                      String              @unique
  phone                      String?
  password                   String?
  passwordHash               String?
  authProvider               String              @default("credentials")
  role                       Role                @default(CUSTOMER)
  isActive                   Boolean             @default(true)
  verifiedAt                 DateTime?
  avatarUrl                  String?
  referralCode               String?             @unique
  referredBy                 String?
  storeId                    String?
  store                      Store?              @relation(fields: [storeId], references: [id])
  addresses                  Address[]
  carts                      CartItem[]
  orders                     Order[]
  voucherUsages              VoucherUsage[]
  storeAdminRequests         StoreAdminRequest[] @relation("StoreAdminRequestUser")
  reviewedStoreAdminRequests StoreAdminRequest[] @relation("StoreAdminRequestReviewer")
  notifications              Notification[]
  auditLogs                  AuditLog[]          @relation("AuditLogActor")
  refreshSessions            RefreshSession[]
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
}

model Store {
  id                          String              @id @default(cuid())
  name                        String
  city                        String
  latitude                    Float
  longitude                   Float
  radiusKm                    Float               @default(10)
  isMain                      Boolean             @default(false)
  admins                      User[]
  stocks                      Inventory[]
  carts                       CartItem[]
  orders                      Order[]
  discounts                   Discount[]
  journals                    StockJournal[]
  requestedStoreAdminRequests StoreAdminRequest[] @relation("RequestedStore")
  assignedStoreAdminRequests  StoreAdminRequest[] @relation("AssignedStore")
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  label         String
  recipientName String?
  phone         String?
  detail        String
  district      String?
  city          String?
  province      String?
  postalCode    String?
  note          String?
  latitude      Float
  longitude     Float
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String          @id @default(cuid())
  sku         String?         @unique
  name        String          @unique
  brand       String?
  shortInfo   String?
  description String?
  storageInfo String?
  weightGram  Int?
  isActive    Boolean         @default(true)
  price       Int
  unit        String
  categoryId  String
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  stocks      Inventory[]
  carts       CartItem[]
  orderItems  OrderItem[]
  discounts   Discount[]
  journals    StockJournal[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  url       String
}

model Inventory {
  id               String   @id @default(cuid())
  storeId          String
  productId        String
  store            Store    @relation(fields: [storeId], references: [id])
  product          Product  @relation(fields: [productId], references: [id])
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([storeId, productId])
  @@index([storeId, quantity])
  @@index([productId])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  storeId   String
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  store     Store    @relation(fields: [storeId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, storeId])
}

model StockJournal {
  id        String   @id @default(cuid())
  storeId   String
  productId String
  store     Store    @relation(fields: [storeId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  change    Int
  note      String
  createdAt DateTime @default(now())
}

model Discount {
  id          String       @id @default(cuid())
  storeId     String
  productId   String?
  store       Store        @relation(fields: [storeId], references: [id])
  product     Product?     @relation(fields: [productId], references: [id])
  title       String
  type        DiscountType
  value       Int
  minSpend    Int?
  maxDiscount Int?
  startsAt    DateTime
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
}

model Voucher {
  id          String         @id @default(cuid())
  code        String         @unique
  title       String
  scope       VoucherScope
  type        DiscountType
  value       Int
  minSpend    Int?
  maxDiscount Int?
  productId   String?
  expiresAt   DateTime
  usages      VoucherUsage[]
  createdAt   DateTime       @default(now())
}

model Order {
  id                     String               @id @default(cuid())
  orderNumber            String               @unique
  userId                 String
  storeId                String
  addressId              String?
  addressSnapshot        Json?
  deliveryDate           DateTime?
  deliverySlot           String?
  shippingMethod         String?
  shippingProvider       String?
  shippingCost           Int                  @default(0)
  serviceFee             Int                  @default(0)
  discountTotal          Int                  @default(0)
  voucherId              String?
  voucherCode            String?
  paymentMethod          String?
  paymentProvider        String?
  paymentChannel         String?
  paymentStatus          PaymentStatus        @default(UNPAID)
  paymentRedirectUrl     String?
  paymentInvoiceUrl      String?
  paymentExternalId      String?
  xenditInvoiceId        String?
  xenditInvoiceStatus    String?
  paidAt                 DateTime?
  paymentExpiredAt       DateTime?
  paymentStockRestoredAt DateTime?
  stockReservedAt        DateTime?
  stockCommittedAt       DateTime?
  stockReleasedAt        DateTime?
  invoiceNumber          String?              @unique
  invoiceSnapshot        Json?
  invoiceCreatedAt       DateTime?
  trackingNumber         String?
  courierName            String?
  estimatedArrival       DateTime?
  orderNote              String?
  user                   User                 @relation(fields: [userId], references: [id])
  store                  Store                @relation(fields: [storeId], references: [id])
  status                 OrderStatus          @default(PENDING_PAYMENT)
  total                  Int
  paymentProofUrl        String?
  paymentDeadline        DateTime?
  items                  OrderItem[]
  histories              OrderStatusHistory[]
  payments               Payment[]
  voucherUsages          VoucherUsage[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([userId, createdAt])
  @@index([storeId, status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([status, createdAt])
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String
  provider   String
  invoiceId  String        @unique
  amount     Int
  status     PaymentStatus @default(PENDING)
  paymentUrl String?
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([orderId, createdAt])
  @@index([status, updatedAt])
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, expiresAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  order       Order   @relation(fields: [orderId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
  quantity    Int
  price       Int
  productName String  @default("")
  sku         String?
  discount    Int     @default(0)
  finalPrice  Int     @default(0)
  subtotal    Int     @default(0)
  imageUrl    String?

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  description String?
  location    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([orderId, createdAt])
}

model VoucherUsage {
  id        String   @id @default(cuid())
  voucherId String
  voucher   Voucher  @relation(fields: [voucherId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  code      String
  discount  Int
  createdAt DateTime @default(now())

  @@unique([userId, voucherId])
  @@index([userId, voucherId])
  @@index([orderId])
}

model StoreAdminRequest {
  id               String                  @id @default(cuid())
  userId           String
  requestedStoreId String?
  reason           String
  experience       String?
  status           StoreAdminRequestStatus @default(PENDING)
  reviewedById     String?
  assignedStoreId  String?
  rejectionReason  String?
  reviewedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  user           User   @relation("StoreAdminRequestUser", fields: [userId], references: [id])
  requestedStore Store? @relation("RequestedStore", fields: [requestedStoreId], references: [id])
  assignedStore  Store? @relation("AssignedStore", fields: [assignedStoreId], references: [id])
  reviewedBy     User?  @relation("StoreAdminRequestReviewer", fields: [reviewedById], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([requestedStoreId])
  @@index([assignedStoreId])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  type          String
  title         String
  message       String
  referenceId   String?
  referenceType String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([referenceId, referenceType])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  requestId  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([email, createdAt])
}
